;;; see swaner-demo.lisp

;;; M-x slime-connect
#|
(defun dostuff ()
  (format t "goodbye world ~a!~%" *counter*))
(setf *counter* 0)

(dostuff)

(bt:all-threads)

(bt:make-thread (lambda ()
		    (loop repeat 5 do
			  (sleep 5)
			  (dostuff)
			  (incf *counter*)))
		  :name "do-stuff")

|#



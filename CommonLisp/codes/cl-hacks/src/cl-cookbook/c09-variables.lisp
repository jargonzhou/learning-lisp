(defpackage :cl-cookbook/c09-variables
  (:use #:cl
        #:log4cl)
  (:export #:hello))

(in-package :cl-cookbook/c09-variables)

(log:info "cl-cookbook/c09-variables")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; defparameter: top-level variable
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defparameter *name* "me"
              "Default name to say hello to.")
;;; docstring
;;; cl-cookbook/c09-variables>(documentation '*name* 'variable)
;;; Default name to say hello to.

(defun hello (&optional name)
  "Say hello."
  (format t "Hello ~a!" (or name *name*)))


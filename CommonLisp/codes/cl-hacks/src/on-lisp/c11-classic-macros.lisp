;;; creating context
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(let ((x 'b)) (list x)) ; (B)

(defmacro our-let (binds &body body)
  `((lambda ,(mapcar #'(lambda (x)
			 (if (consp x) (car x) x))
	      binds)
      ,@body)
    ,@ (mapcar #'(lambda (x)
		   (if (consp x) (cadr x) nil))
	       binds)))
(our-let ((x 1) (y 2))
  (+ x y)) ; 3
(pprint (macroexpand-1 '(our-let ((x 1) (y 2)) (+ x y))))
;; ((LAMBDA (X Y) (+ X Y)) 1 2); No value


;;; generalization of assignment done by function call
;;; destructuring-bind
;;; destructure in macro parameter lists

(defmacro our-dolist ((var list &optional result) &body body)
  `(progn
     (mapc #'(lambda (,var) ,@body)
	   ,list)
     (let ((,var nil))
       ,result)))
(dolist (x '(a b c))
  (print x))
;; A 
;; B 
;; C 
;; NIL
(our-dolist (x '(a b c2))
  (print x))
;; A 
;; B 
;; C2 
;; NIL

(defmacro when-bind ((var expr) &body body)
  `(let ((,var ,expr))
     (when ,var
       ,@body)))
(when-bind (input (+ 1 2))
  input) ; 3



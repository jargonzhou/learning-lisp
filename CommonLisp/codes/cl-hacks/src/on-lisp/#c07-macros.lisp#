(defmacro nif (expr pos zero neg)
  `(case (truncate (signum ,expr))
     (1 ,pos)
     (0 ,zero)
     (-1 ,neg)))
(mapcar #'(lambda (x)
	    (nif x 'p 'z 'n))
	'(0 2.5 -8)) ; (Z P N)

